<?xml version="1.0" encoding="utf-8"?>
<!-- 深色主题下的功能键：比字母键更暗一档 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#33373F"
                android:endColor="#2C3038" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#4D7C828E" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#272A30"
                android:endColor="#22252A" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#4D7C828E" />
        </shape>
    </item>
</selector>
