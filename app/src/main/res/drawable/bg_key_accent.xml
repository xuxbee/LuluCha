<?xml version="1.0" encoding="utf-8"?>
<!-- 主操作键：蓝色玻璃（浅色底上加重一档） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#D94C8DFF"
                android:endColor="#A64C8DFF" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#8CFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#C24C8DFF"
                android:endColor="#8C4C8DFF" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#80FFFFFF" />
        </shape>
    </item>
</selector>
